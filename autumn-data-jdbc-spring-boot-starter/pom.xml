<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-data</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-data-jdbc-spring-boot-starter</artifactId>
	<name>autumn-data-jdbc-spring-boot-starter</name>
	<description>autumn-data-jdbc 的 Spring Boot 集成层：自动配置 Dialect、对接 DataSource。仿 MyBatis 分层——核心零 Spring，Spring 依赖集中在本模块。</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- 被集成的核心库（零 Spring） -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-jdbc</artifactId>
		</dependency>
		<!-- 方言抽象（自动配置直接引用 Dialect / DialectResolver） -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-common</artifactId>
		</dependency>
		<!-- 动态表 CRUD（MetaMapper / MetaTableRegistry），核心零 Spring -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-meta-jdbc</artifactId>
		</dependency>
		<!-- Spring Boot JDBC 基础设施：DataSource 绑定、HikariCP、spring-jdbc/spring-tx、logging starter -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- 自动配置注解（@AutoConfiguration/@ConditionalOnXxx） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>

		<!-- 测试 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- 生成 autumn.data.jdbc.* 配置项的 IDE 元数据（原生支持，不进依赖树） -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
