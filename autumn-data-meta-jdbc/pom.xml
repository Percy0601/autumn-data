<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-data</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-data-meta-jdbc</artifactId>
	<name>autumn-data-meta-jdbc</name>
	<description>轻量动态 SQL 引擎 + 运行期实体类生成：Mapper XML 复用 autumn-data-common 的方言（动态 SQL 运行期解释执行）；MetaMapper 返回的 MetaClass 是按表结构用 FreeMarker 生成 Java 源码、javax.tools 编译加载的实体子类，有真实类型化字段与 getter、逐行映射零反射。方言复用 autumn-data-common，执行层复用 autumn-data-jdbc。</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- 方言抽象（Dialect / DialectResolver / 各库实现）：公共 JDBC 底座 -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-common</artifactId>
		</dependency>
		<!-- 执行层：AutumnJdbc / ConnectionSource / RowMapper -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-jdbc</artifactId>
		</dependency>
		<!-- 运行期实体类源码生成（版本由 spring-boot-dependencies BOM 管理） -->
		<dependency>
			<groupId>org.freemarker</groupId>
			<artifactId>freemarker</artifactId>
		</dependency>

		<!-- 测试：H2 内存库 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
