<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-data</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-data-meta-jdbc</artifactId>
	<name>autumn-data-meta-jdbc</name>
	<description>轻量动态 SQL 引擎：对标 MyBatis Mapper XML，复用 autumn-data-common 的 XML 方言（参数占位符走 JDBC 绑定、标识符走白名单拼接，支持 if/choose/foreach/where/trim），首次访问按表结构生成 Mapper 文件、之后归使用方编辑，运行期解释执行（无模板引擎）。方言复用 autumn-data-common，执行层复用 autumn-data-jdbc。</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- 方言抽象（Dialect / DialectResolver / 各库实现）：公共 JDBC 底座 -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-common</artifactId>
		</dependency>
		<!-- 执行层：AutumnJdbc / ConnectionSource / RowMapper -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-jdbc</artifactId>
		</dependency>

		<!-- 测试：H2 内存库 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
