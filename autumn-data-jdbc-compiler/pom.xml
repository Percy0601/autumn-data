<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-data</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-data-jdbc-compiler</artifactId>
	<name>autumn-data-jdbc-compiler</name>
	<description>JSR-269 注解处理器：编译期为 @AutumnRepository 接口生成实现类。仅编译期使用（provided / annotationProcessorPaths），运行时不依赖。</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<!-- 开发期模块：暂不发布（随 M2 稳定后开放） -->
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>

	<dependencies>
		<!-- 编译期方言（决定生成 SQL 是否给标识符加引号），故 provided -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-common</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- 处理器自测：用系统 JavaCompiler 起进程内编译 -->
		<!-- 生成代码引用 AutumnJdbc / RowMapper / @Service，进程内编译产物时需要它们在测试类路径上（处理器本身不依赖 Spring） -->
		<dependency>
			<groupId>xyz.wewin.autumn</groupId>
			<artifactId>autumn-data-jdbc-spring-boot-starter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
