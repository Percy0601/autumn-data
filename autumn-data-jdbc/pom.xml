<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>xyz.wewin.autumn</groupId>
		<artifactId>autumn-data</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>autumn-data-jdbc</artifactId>
	<name>autumn-data-jdbc</name>
	<description>零反射 JDBC 仓储：Spring Data 注解风格 + 编译期处理（参考 Micronaut Data）。核心零 Spring 依赖，数据源 HikariCP；Spring Boot 集成见 autumn-data-jdbc-spring-boot-starter。</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- 核心模块零 Spring：只保留连接池与 JDK java.sql/javax.sql。版本由父 BOM（spring-boot-starter-parent）管理 -->
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
		</dependency>
		<!-- JPA 注解（@Entity / @Table / @Id / @Column / @GeneratedValue），供编译期读取实体元数据 -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
		</dependency>
		<!-- 日志门面（仅 API，不带实现；Spring 集成见 autumn-data-jdbc-spring-boot-starter） -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<!-- 测试：H2 内存库（验证方言识别与未来生成的仓储） -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
