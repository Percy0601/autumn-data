<?xml version="1.0" encoding="UTF-8"?>
<!--
    使用方手写的语句 XML 示例（对应 demo_order 表）：一张表一个文件。

    放的位置：src/main/resources/meta/{数据源}/{命名空间}/{表名}.xml（测试里放 src/test/resources 同理）。
    查找顺序是 {语句根}/{数据源}/{命名空间}/{表名}.xml → classpath 同名资源，
    表名大小写都能对上。本文件没有 GENERATED 标记，因此是使用方资产：框架一个字都不改写，
    只在内存补齐七条默认语句（findList / findPage / findOne / findById / save / update / delete）。
    想让框架按表结构维护默认语句，就保留 AUTUMN-DATA GENERATED START/END 标记——
    表结构变化时只重写标记之间的生成块，标记外的自定义语句逐字保留。

    三条写法约定：
      #{}    解析阶段就摘成 JDBC 绑定，SQL 文本里只留 ?，值不进文本；
      ${}    只做标识符拼接，展开结果必须过标识符白名单（分号、引号、注释符、比较符直接拒绝）；
             ${table} 由框架按方言填好带引号的表名，调用方不用传；
      test   只认 MyBatis 写法（a != null / a == 'x' / a != '' / !a / a &amp;&amp; b）；
             changed('col') 是框架内置谓词，读实体变更集，区分「这一列没动」与「显式置 NULL」。

    <sql>/<include> 与 <resultMap>/<result> 都在解析阶段展开：include 内联成 SQL 片段，
    resultMap 换成「结果集列名 → MetaClass 属性名」的映射清单。

    列名这里不加引号：交给数据库自身的大小写规则，MySQL / H2 / Oracle 都能跑。
-->
<mapper namespace="using.demo_order">

    <!-- 片段：被下面的 select 引用，解析阶段内联，运行期没有额外开销 -->
    <sql id="orderColumns">id, order_no, user_id, amount</sql>

    <!-- 映射：SELECT 起别名后，按 column → property 把结果列落回实体的属性 -->
    <resultMap id="orderView" type="demo_order">
        <id column="id" property="id"/>
        <result column="no" property="order_no"/>
        <result column="user_id" property="user_id"/>
        <result column="total" property="amount"/>
    </resultMap>

    <!-- 动态条件列表：<where> 整段为空时连 WHERE 一起省掉；ORDER BY 走 ${} 标识符 -->
    <select id="search">
        SELECT <include refid="orderColumns"/> FROM ${table}
        <where>
            <if test="order_no != null">AND order_no LIKE #{order_no}</if>
            <if test="user_id != null">AND user_id = #{user_id}</if>
            <if test="minAmount != null">AND amount &gt;= #{minAmount}</if>
            <if test="ids != null">AND id IN
                <foreach collection="ids" item="one" open="(" separator="," close=")">#{one}</foreach>
            </if>
        </where>
        <if test="orderBy != null">ORDER BY ${orderBy}</if>
    </select>

    <!-- 只按单号取一行；别名 no / total 由上面的 resultMap 映射回 order_no / amount -->
    <select id="byOrderNo" resultMap="orderView">
        SELECT id, order_no AS no, user_id, amount AS total FROM ${table} WHERE order_no = #{order_no}
    </select>

    <!-- 计数：selectCount 走这条语句，返回第一列的数字 -->
    <select id="countMatching">
        SELECT COUNT(*) FROM ${table}
        <where>
            <if test="user_id != null">AND user_id = #{user_id}</if>
            <if test="maxAmount != null">AND amount &lt; #{maxAmount}</if>
        </where>
    </select>

    <!-- 二选一排序：<choose> 命中第一个为真的分支，都不命中走 otherwise -->
    <select id="listSorted">
        SELECT id, order_no FROM ${table}
        <choose>
            <when test="latest">ORDER BY id DESC</when>
            <otherwise>ORDER BY id ASC</otherwise>
        </choose>
    </select>

    <!-- 只写调用方给了值的列；自增主键不出现，缺省列交给数据库默认值 -->
    <insert id="quickAdd">
        INSERT INTO ${table}
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="order_no != null">order_no,</if>
            <if test="user_id != null">user_id,</if>
            <if test="amount != null">amount,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="order_no != null">#{order_no},</if>
            <if test="user_id != null">#{user_id},</if>
            <if test="amount != null">#{amount},</if>
        </trim>
    </insert>

    <!-- 部分更新：#{} 的键在参数里出现才拼这一段，所以「不传」就是这一列不动 -->
    <update id="patch">
        UPDATE ${table}
        <trim prefix="SET " suffixOverrides=",">
            <if test="amount != null">amount = #{amount},</if>
            <if test="user_id != null">user_id = #{user_id},</if>
        </trim>
        WHERE id = #{id}
    </update>

    <!-- 想显式把一列写成 NULL 就别判空：绑到什么写什么，NULL 也是使用方的意图 -->
    <update id="setAmount">UPDATE ${table} SET amount = #{amount} WHERE id = #{id}</update>

    <!-- 自定义删除语句：删除语义由 XML 决定，框架不再禁止物理删除 -->
    <delete id="purgeById">DELETE FROM ${table} WHERE id = #{id}</delete>
</mapper>
